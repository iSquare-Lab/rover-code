{
  "name": "rover-code",
  "version": "1.0.0",
  "private": true,
  "description": "A programming game: write real Python to drive a rover across Mars. Python runs in your browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pars": "node scripts/pars.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/sora": "^5.2.0",
    "@lezer/highlight": "^1.2.5",
    "pyodide": "^314.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
